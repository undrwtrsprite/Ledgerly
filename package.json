{
  "name": "ledgerly-invoices",
  "private": true,
  "version": "1.6.1",
  "description": "Local-first, privacy-focused invoicing for independent businesses",
  "author": "Ledgerly contributors",
  "license": "GPL-3.0-or-later",
  "keywords": [
    "invoicing",
    "invoice",
    "local-first",
    "privacy",
    "electron",
    "react"
  ],
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "frontend:verify": "npm run typecheck && npm test && npm run build",
    "frontend:bundle": "npm run frontend:verify && node scripts/create-frontend-manifest.mjs",
    "desktop:dev": "npm run build && electron .",
    "desktop:build": "npm run build && electron-builder --mac dir",
    "desktop:package": "npm run build && electron-builder --mac dmg zip"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.2.2",
    "typescript": "7.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "lucide-react": "1.45.0",
    "jspdf": "4.2.1"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "electron": "44.1.1",
    "electron-builder": "26.15.3",
    "vitest": "4.1.11"
  },
  "build": {
    "appId": "com.ledgerly.invoices",
    "productName": "Ledgerly",
    "artifactName": "Ledgerly-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/**/*.test.*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Ledgerly ${version}",
      "icon": "build/icon.icns",
      "backgroundColor": "#f5f4ef",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 185,
          "type": "file"
        },
        {
          "x": 390,
          "y": 185,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
